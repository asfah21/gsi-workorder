# =============================================================================
# GSI Work Order & Maintenance - contoh konfigurasi
# Salin file ini menjadi .env, lalu ubah nilainya. Jangan commit file .env.
#
# Penting:
# - POSTGRES_PASSWORD dan password di DATABASE_URL harus sama.
# - Gunakan password yang URL-safe (huruf, angka, - atau _), atau URL-encode
#   karakter khusus sebelum memasukkannya ke DATABASE_URL.
# - File .env dibaca oleh Docker Compose dan diteruskan ke container.
# =============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-use-a-url-safe-password
# Host `db` hanya berlaku di dalam jaringan Docker Compose.
DATABASE_URL=postgres://gsi:change-me-use-a-url-safe-password@db:5432/workorder?sslmode=disable

# --- API --------------------------------------------------------------------
# Port di dalam container. Mapping Compose memakai 8080; jika diubah, ubah juga
# mapping port dan healthcheck API di docker-compose.yml.
PORT=8080
GIN_MODE=release
# Wajib 32+ karakter acak. Dipakai mulai Milestone 1 (JWT).
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- Web --------------------------------------------------------------------
# URL API yang dapat diakses browser. Belum dipakai pada Milestone 0.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Odoo (read-only, hanya diakses worker; mulai Milestone 2) --------------
ODOO_BASE_URL=http://10.10.11.2:8068
ODOO_SERVICE_LOGIN=
ODOO_SERVICE_PASSWORD=
# ODOO_TOKEN=

# --- Worker / sinkronisasi (mulai Milestone 2) ------------------------------
SYNC_INTERVAL=15m
SYNC_CONCURRENCY=4

# --- Setting aplikasi -------------------------------------------------------
# SUMBER KEBENARAN: tabel app_settings. Nilai di bawah hanya dokumentasi
# dan TIDAK dibaca aplikasi.
#
# Default yang di-seed oleh migrasi:
#   p2h_auto_wo             = false
#   candidate_sla_hours     = 24
#   candidate_backfill_days = 30
#
# Perubahan resmi dilakukan oleh admin melalui PATCH /api/settings (M4) dan
# dicatat di app_settings_history.
# CANDIDATE_AUTO_APPROVE=false
# CANDIDATE_SLA_HOURS=24
# CANDIDATE_BACKFILL_DAYS=30

# --- Upload & waktu ---------------------------------------------------------
UPLOAD_DIR=/data/uploads
TZ=Asia/Jakarta

# --- URL publik aplikasi ----------------------------------------------------
APP_PUBLIC_URL=http://localhost:3000

# --- Admin pertama (mulai Milestone 1) --------------------------------------
# SEED_ADMIN_NIK=

# --- SMTP opsional (fase 2) -------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
